# Copy to .env and fill in secrets. Never commit .env.
# APP_ENV selects an optional extra file .env.<APP_ENV> if you add one.

APP_ENV=development
PORT=3000
HOST=localhost
BASE_PATH=
FRONTEND_URL=http://localhost:4200
VITE_API_PROXY_TARGET=http://localhost:3000
TRUST_PROXY=
TEST_TOOLING_ENABLED=false

# --- OIDC (Keycloak or any OIDC provider) ---
OIDC_ISSUER_URL=https://idp.example.com/realms/example
OIDC_CLIENT_ID=leave-management
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4200/api/auth-oidc/callback
OIDC_SCOPE="openid email profile"
JWT_SECRET=
JWT_EXPIRES_IN=1h
SESSION_SECRET=
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
OIDC_ADMIN_ROLE=lrs-admins
OIDC_EMPLOYEE_ROLE=lrs-employees

# --- Email ---
COMMUNICATION_EMAIL_SMTP_HOST=localhost
COMMUNICATION_EMAIL_SMTP_PORT=1025
COMMUNICATION_EMAIL_SMTP_SECURE=false
COMMUNICATION_EMAIL_SMTP_USER=
COMMUNICATION_EMAIL_SMTP_PASSWORD=
COMMUNICATION_EMAIL_DEFAULT_FROM_EMAIL=noreply@example.com
COMMUNICATION_EMAIL_DEFAULT_FROM_NAME="Leave Management System"

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leave_management
DB_USER=postgres
DB_PASSWORD=postgres

# --- LDAP user sync (optional; leave false if you have no directory) ---
LDAP_SYNC_ENABLED=false
LDAP_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=uid=leave-app,ou=System,ou=Users,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=ou=Users,dc=example,dc=com
LDAP_ADMIN_GROUP_DN=cn=lrs-admins,ou=leave-app,ou=Roles,dc=example,dc=com
LDAP_EMPLOYEE_GROUP_DN=cn=lrs-employees,ou=leave-app,ou=Roles,dc=example,dc=com
LDAP_USER_FILTER=(objectClass=inetOrgPerson)
LDAP_SYNC_CRON_ENABLED=false

# --- Frontend ---
VITE_BASE_PATH=/
VITE_COMPANY_NAME="Acme, Inc."
